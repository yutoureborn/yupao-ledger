{
  "name": "yupao-ledger",
  "main": "build/worker/index.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yupao-ledger-db",
      "database_id": "e3c15842-eb22-4075-8c47-be119a85edc9",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "HOUSEHOLD_NAME": "芋炮之家",
    "AUTH_BYPASS": "false",
    "PASSWORD_ITERATIONS": "120000"
  }
}
